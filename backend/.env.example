# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=VitalTrack API
ENVIRONMENT=development
DEBUG=true

# ── Database (Supabase Transaction Pooler — port 6543) ────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Redis (Railway or local) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
JWT_SECRET_KEY=your-supabase-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CORS (comma-separated in .env, list in settings.py) ──────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","https://app.vitaltrack.health"]

# ── Feature flags ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555
